# Copy with npm run setup. Never commit your populated .env.
# Expo extra and web configuration are visible in the built app.
# Use isolated, restricted demo credentials. Production provider secrets belong
# on a trusted backend; .env does not make client-side credentials confidential.

# Firebase web app configuration (required for authentication and persistence)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Active integrations (optional until their features are used)
CLARIFAI_PAT=
OCR_SPACE_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=

APP_ENV=development
API_URL=http://localhost:3000
# Optional: configure after creating your own EAS project
EAS_PROJECT_ID=
